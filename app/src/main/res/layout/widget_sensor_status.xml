<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/left_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:id="@+id/cell_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dot_wifi"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/label_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/status_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_border"
            android:text="" />

        <LinearLayout
            android:id="@+id/cell_bt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dot_bt"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/label_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/status_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/section_divider"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/widget_accent"
        android:text="" />

    <FrameLayout
        android:id="@+id/right_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cell_mic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dot_mic"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/label_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mic"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/status_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/widget_border"
                android:text="" />

            <LinearLayout
                android:id="@+id/cell_cam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dot_cam"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/label_cam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cam"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/status_cam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:paddingTop="2dp"
            android:textSize="8sp" />
    </FrameLayout>
</LinearLayout>
