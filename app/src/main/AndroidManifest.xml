<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions (normal: wifi) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Permissions (bluetooth — BLUETOOTH_CONNECT is dangerous on API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Permissions (runtime required: mic, camera) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Hardware features (not required — app works without camera/mic) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".EzWorkSafeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EzWorkSafe"
        tools:targetApi="36">
        <activity
            android:name=".ui.view.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EzWorkSafe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MonitoringService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time monitoring of WiFi, Bluetooth, microphone, and camera sensor state for workplace safety/privacy awareness. Observes system service callbacks to detect state changes and pushes updates to home screen widget and persistent notification. Does not fit standard FGS types because it passively monitors multiple unrelated sensor types without directly accessing the hardware." />
        </service>

        <receiver
            android:name=".widget.SensorWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_sensor" />
        </receiver>

        <receiver
            android:name=".widget.CompactWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
        </receiver>

    </application>
</manifest>
