# Auto-detect text files and normalize to LF on check-in
* text=auto

# Gradle wrapper scripts
gradlew          text eol=lf
# gradlew.bat is deliberately NOT normalized (see bottom of file). Dependabot
# rewrites it server-side with CRLF and never passes through the local clean
# filter, so `text eol=crlf` left git reporting a phantom modification on a
# byte-identical file after every gradle-wrapper bump.

# Build scripts
*.gradle.kts     text eol=lf
*.gradle         text eol=lf

# Source files
*.kt             text eol=lf
*.kts            text eol=lf
*.java           text eol=lf
*.xml            text eol=lf
*.properties     text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.json           text eol=lf
*.md             text eol=lf

# Shell scripts
*.sh             text eol=lf

# Windows batch
*.bat            text eol=crlf
*.cmd            text eol=crlf

# ProGuard rules
proguard-rules.pro  text eol=lf

# Binary files — do not touch
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.webp           binary
*.keystore       binary
*.jks            binary
*.db             binary
*.so             binary
*.jar            binary
*.aar            binary

# Git hooks (must stay LF on all platforms)
.gitattributes   text eol=lf
.githooks/**     text eol=lf

# Generated Gradle wrapper script — treat as opaque bytes.
# This MUST come after the `*.bat text eol=crlf` rule above: in .gitattributes
# the last matching line wins, so this is what actually disables normalization.
# Without `-text`, git smudges the blob to CRLF on checkout and cleans it back to
# LF on add, so a CRLF blob pushed by Dependabot can never round-trip and git
# reports a modification that is not there. Gradle regenerates this file and it
# is never hand-edited, so byte-for-byte fidelity matters more than diffs.
gradlew.bat      -text
